{
  "name": "stac-zod",
  "version": "0.1.0",
  "description": "Zod schemas for STAC 1.0.0 (SpatioTemporal Asset Catalog)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "bin": {
    "stac-zod": "./dist/cli.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "validate": "node dist/cli.js validate",
    "smoke-test": "node dist/cli.js validate https://dev.disasters.openveda.cloud/api/stac/",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "zod": ">=3"
  },
  "devDependencies": {
    "@apidevtools/json-schema-ref-parser": "^11",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "json-schema-to-zod": "^2",
    "tsup": "^8",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^2",
    "zod": "^3"
  },
  "keywords": [
    "stac",
    "zod",
    "schema",
    "validation",
    "geospatial"
  ],
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vgeorge/stac-zod.git"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "ora": "^9.4.0",
    "p-limit": "^7.3.0"
  }
}
